{% if rows|length %}
    <table class="data fullwidth">
        <tbody>
            {% for row in rows %}
                <tr>
                    <td>
                        {% if row.source starts with 'http' %}
                            <a href="{{ row.source }}" target="_blank" rel="noopener">{{ row.filename }}</a>
                        {% else %}
                            {{ row.filename }}
                        {% endif %}
                    </td>
                    {% if showCrawlers %}
                        <td class="rightalign" title="{{ '{count} downloads in all, {crawlers} crawlers'|t('download-tracker', { count: row.count|number, crawlers: row.crawlerCount|number }) }}">
                            <strong>{{ row.userCount|number }}</strong>
                        </td>
                    {% else %}
                        <td class="rightalign"><strong>{{ row.count|number }}</strong></td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p class="light">{{ "No downloads tracked yet."|t('download-tracker') }}</p>
{% endif %}
